# VayuChakra credentials. Copy to .env and fill in. .env is git-ignored.
#
# Everything here is FREE. There is no paid service anywhere in this project.
# Without these keys the system still runs and degrades honestly: the pipeline
# reports which stages could not run rather than silently producing a number.

# OpenAQ v3 — CPCB station observations, live and historical.
# Free key: https://explore.openaq.org/  (register, then Account -> API Keys)
OPENAQ_API_KEY=

# NASA FIRMS — VIIRS/MODIS active fire detections for the stubble plume model.
# Free key by email: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional. Not used by the forecast; present for parity with the sibling project.
GROQ_API_KEY=

# Not required, and deliberately so:
#   Open-Meteo forecast, ERA5 archive and CAMS air quality are all keyless.
#   They supply the meteorology, the boundary-layer height, the pressure-level
#   temperatures and the chemistry prior.
